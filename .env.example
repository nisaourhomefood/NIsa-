# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── Supabase (dormant fallback — Shopify is the live product source) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cashfree Payment Gateway (connected as a Shopify payment provider; these
#    keys are only used by the dormant custom /checkout fallback flow) ──
CASHFREE_APP_ID=
NEXT_PUBLIC_CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=PRODUCTION

# ── Storefront Domain (used for Cashfree webhook notify_url) ──
NEXT_PUBLIC_BASE_URL=https://www.nisaourhomefood.in

# ── Shiprocket Delivery Partner ──
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Home

# ── WhatsApp Order Flow (customer pays via UPI, dormant custom flow) ──
NEXT_PUBLIC_STORE_WHATSAPP_NUMBER=917569344938
NEXT_PUBLIC_STORE_UPI_ID=

# ── WhatsApp Order Notifications (Meta WhatsApp Cloud API) ──
# Setup: business.facebook.com -> WhatsApp -> API Setup. Needs an approved
# message template per message type (see src/lib/services/whatsapp-service.ts).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=order_shipped
WHATSAPP_ORDER_CONFIRMED_TEMPLATE_NAME=order_confirmed
WHATSAPP_TEMPLATE_LANG=en

# ── Shopify Order-Paid Webhook (auto WhatsApp confirmation) ──
# Settings -> Notifications -> Webhooks -> Create webhook -> Event: "Order payment"
SHOPIFY_WEBHOOK_SECRET=

# ── Shopify Headless Storefront Integration (the live product/checkout source) ──
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=nisaourhomefoods.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-01
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_REVALIDATION_SECRET=

# ── Admin Portal Auth (gates /admin/* and /api/admin/* via middleware) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Google Analytics 4 + Search Console (blank = inert, nothing loads) ──
# GA4: analytics.google.com -> Admin -> create a GA4 property for this site ->
# Data Streams -> Web -> copy the Measurement ID (starts with G-).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Search Console: search.google.com/search-console -> Add property -> URL prefix
# -> HTML tag verification method -> copy just the content="..." value here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Shopify Customer Account API (branded login + order history at /account) ──
# Setup: Shopify Admin -> Settings -> Customer accounts -> set to "New customer
# accounts" -> Customer Account API -> create a client. That screen shows the
# exact Authorize/Token/GraphQL/Logout URLs below (they embed your numeric shop
# ID — do not guess them). Add this redirect URI there: {BASE_URL}/api/auth/callback
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_AUTHORIZE_URL=
SHOPIFY_CUSTOMER_ACCOUNT_TOKEN_URL=
SHOPIFY_CUSTOMER_ACCOUNT_API_URL=
SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_URL=
